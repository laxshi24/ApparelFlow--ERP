# --- Required -----------------------------------------------------------------
# PostgreSQL connection string. Local default matches `npm run db:start`.
# Production: use your managed provider's pooled URL (e.g. Neon "-pooler" host) with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/apparelflow

# --- Optional -----------------------------------------------------------------
# Connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5
# Session lifetime in hours (1-72).
SESSION_TTL_HOURS=8

# Passwords set on the three user accounts by `npm run db:seed` (min 10 characters each).
# Avoid "#" in values (dotenv treats it as a comment start). Use different, strong values in production.
SEED_SUPERVISOR_PASSWORD=Supervisor@2026
SEED_VERIFIER_PASSWORD=Verifier@2026
SEED_SEWING_PASSWORD=Sewing@2026

# Test database used by `npm run test:integration` (dropped/recreated schema on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/apparelflow_test

# End-to-end tests (Playwright): schema wiped and reseeded on every run.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:54329/apparelflow_e2e

# Optional: direct (non-pooled) connection used only for migrations (e.g. Neon DATABASE_URL_UNPOOLED).
# MIGRATION_DATABASE_URL=

# Optional: IANA timezone used to display timestamps (stored in UTC). Default Asia/Colombo.
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Colombo
