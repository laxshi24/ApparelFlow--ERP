# --- Required -----------------------------------------------------------------
# PostgreSQL connection string. Local default matches `npm run db:start`.
# Production: use your managed provider's pooled URL (e.g. Neon "-pooler" host) with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/apparelflow

# --- Optional -----------------------------------------------------------------
# Connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5
# Session lifetime in hours (1-72).
SESSION_TTL_HOURS=8

# Demo credential panel on the login page. Enable only for evaluation deployments.
DEMO_MODE=true
# Password applied to the three seeded demo users by `npm run db:seed`, and shown in the demo panel.
DEMO_PASSWORD=ApparelFlow#Demo2026

# Test database used by `npm run test:integration` (dropped/recreated schema on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/apparelflow_test
